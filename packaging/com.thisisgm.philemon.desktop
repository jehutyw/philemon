[Desktop Entry]
Type=Application
Name=Philemon
GenericName=File Manager
Comment=Fast, keyboard-first file manager
# --gui states the mode rather than choosing it: bare philemon opens the window too, so the flag is a contract, not a correction.
Exec=philemon --gui %f
Icon=com.thisisgm.philemon
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folder;manager;browser;philemon;
StartupWMClass=com.thisisgm.philemon
